# Othello RL web app settings (read by app.py / monitor.py; changes apply without a restart)

# Show the "Training Monitor" menu and page (/monitor), including the start/stop training controls.
# true / false
ENABLE_TRAINING_MONITOR=true

# Search depth of the classic opponents on the website (1-8). Higher = stronger but slower.
MINIMAX_DEPTH=3
ALPHABETA_DEPTH=5

# Trained models that are also offered with Monte-Carlo tree search ("ddqn+mcts"), comma separated.
# Much stronger than the network alone, but each move takes MCTS_SIMS network evaluations.
MCTS_MODELS=ddqn,ppo

# Tree-search simulations per move (10-1000). 100 is ~0.2 s on a modern core, ~0.5 s on an old i5.
MCTS_SIMS=100

# Solve the game exactly (perfect play) once this many squares are empty (0 = off, max 14).
# 10 takes ~0.1 s; 12 ~1 s.
MCTS_SOLVE_EMPTIES=10
