# Othello RL web app settings (read by app.py / monitor.py; changes apply without a restart)

# Show the "Training Monitor" menu and page (/monitor), including the start/stop training controls.
# true / false
ENABLE_TRAINING_MONITOR=true

# Search depth of the classic opponents on the website (1-8). Higher = stronger but slower.
MINIMAX_DEPTH=3
ALPHABETA_DEPTH=5
